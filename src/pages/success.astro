---
import Base from "../layouts/Base.astro";
---

<Base title="Order Confirmed" description="Your order has been placed successfully.">
  <main class="mx-auto max-w-2xl px-6 py-20 text-center">
    <h1 class="font-serif text-3xl font-light">Thank you!</h1>
    <p class="mt-4 opacity-70">
      Your order has been placed. You'll receive a confirmation email shortly.
    </p>
    <a
      href="/shop"
      class="mt-8 inline-block px-6 py-3 bg-ink text-paper rounded-full text-sm uppercase tracking-[.06em] font-semibold hover:-translate-y-px transition-transform"
    >
      Back to Shop
    </a>
  </main>
  <script>
    import { clearCart } from "../stores/cart";
    clearCart();
  </script>
</Base>
