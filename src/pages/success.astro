---
import Base from "../layouts/Base.astro";
---

<Base title="Order Confirmed" description="Your order has been placed successfully.">
  <main
    class="mx-auto max-w-2xl px-4 py-20 text-center"
    x-data
    x-init="$store.cart.clear()"
  >
    <h1 class="text-3xl font-bold text-stone-800">Thank you!</h1>
    <p class="mt-4 text-stone-600">
      Your order has been placed. You'll receive a confirmation email shortly.
    </p>
    <a
      href="/shop"
      class="mt-8 inline-block rounded bg-stone-800 px-6 py-3 text-sm text-white hover:bg-stone-700"
    >
      Back to Shop
    </a>
  </main>
</Base>
