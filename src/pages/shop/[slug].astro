---
import Base from "../../layouts/Base.astro";
import AddToCartButton from "../../components/AddToCartButton";
import ProductCard from "../../components/ProductCard.astro";
import { sanity, urlFor } from "../../lib/sanity";
import { mapSanityProduct, type Product } from "../../data/products";

const { slug } = Astro.params;

const raw = await sanity.fetch(
  `*[_type == "product" && slug.current == $slug][0]{
    _id, title, description, shortDescription, care, dimensions, status, price,
    images, available,
    category,
    "slug": slug.current,
    "imageUrl": images[0].asset->url,
    "imageUrls": images[].asset->url
  }`,
  { slug }
);

if (!raw) {
  return Astro.redirect("/shop");
}

const product = mapSanityProduct(raw, 0);
const ogImage = raw.images?.[0]
  ? urlFor(raw.images[0]).width(1200).height(630).url()
  : undefined;

const galleryImages = (raw.images || []).slice(0, 6);
const galleryUrls: { full: string; thumb: string }[] = galleryImages.map((img: any) => ({
  full: urlFor(img).width(900).height(900).fit("crop").url(),
  thumb: urlFor(img).width(200).height(200).fit("crop").url(),
}));
const hasGallery = galleryUrls.length > 0;
const isAvailable = product.status === "open";

let related: Product[] = [];
if (product.category) {
  const rawRelated = await sanity.fetch(
    `*[_type == "product" && category == $category && slug.current != $slug][0...3]{
      _id, title, price, description, shortDescription, status,
      category,
      "slug": slug.current,
      "imageUrl": images[0].asset->url,
      available
    }`,
    { category: product.category, slug }
  );
  related = rawRelated.map((p: any, i: number) => mapSanityProduct(p, i));
}
if (related.length === 0) {
  const rawRelated = await sanity.fetch(
    `*[_type == "product" && slug.current != $slug][0...3]{
      _id, title, price, description, shortDescription, status,
      category,
      "slug": slug.current,
      "imageUrl": images[0].asset->url,
      available
    }`,
    { slug }
  );
  related = rawRelated.map((p: any, i: number) => mapSanityProduct(p, i));
}
---

<Base
  title={product.name}
  description={product.shortDescription || product.description || `${product.name} — handmade pottery.`}
  image={ogImage}
  showMarquee={false}
>
  <!-- Breadcrumb -->
  <nav class="px-4 sm:px-7 pt-8 pb-6 font-mono text-[11px] tracking-[.12em] uppercase opacity-65">
    <a href="/shop" class="hover:opacity-100 hover:underline underline-offset-[3px]">Shop</a>
    <span class="px-2 opacity-40">/</span>
    <span>{product.name}</span>
  </nav>

  <main class="px-4 sm:px-7 pb-32 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-x-12 xl:gap-x-20">

      <!-- ── Gallery column ── -->
      <div class:list={[product.status !== "open" && "opacity-60"]}>

        <!-- Main image -->
        <div class="relative aspect-square overflow-hidden bg-cream">
          {hasGallery ? (
            <img
              id="gallery-main"
              src={galleryUrls[0].full}
              alt={product.name}
              class="w-full h-full object-cover"
            />
          ) : (
            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs tracking-[.12em] uppercase opacity-50">
              No image
            </span>
          )}

          <!-- Zoom button -->
          {hasGallery && (
            <button
              id="gallery-zoom"
              class="absolute top-3 right-3 w-9 h-9 rounded-full bg-bone/80 backdrop-blur-sm border border-ink/10 flex items-center justify-center hover:bg-bone transition-colors"
              aria-label="View fullscreen"
            >
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M9.5 1.5h4v4M13.5 1.5l-5 5M5.5 13.5h-4v-4M1.5 13.5l5-5"/>
              </svg>
            </button>
          )}

          <!-- Mobile slide dots -->
          {galleryUrls.length > 1 && (
            <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-2 lg:hidden">
              {galleryUrls.map((_: any, i: number) => (
                <button
                  type="button"
                  data-gallery-dot
                  class:list={[
                    "h-1.5 rounded-full transition-all duration-200",
                    i === 0 ? "w-4 bg-ink" : "w-1.5 bg-ink/30",
                  ]}
                  aria-label={`Image ${i + 1}`}
                />
              ))}
            </div>
          )}
        </div>

        <!-- Thumbnail strip -->
        {galleryUrls.length > 1 && (
          <div class="mt-3 flex gap-2 flex-wrap">
            {galleryUrls.map((g: { full: string; thumb: string }, i: number) => (
              <button
                type="button"
                data-gallery-thumb
                data-full={g.full}
                class:list={[
                  "aspect-square w-16 border overflow-hidden bg-cream shrink-0 transition-colors",
                  i === 0 ? "border-ink" : "border-ink/25 hover:border-ink/60",
                ]}
                aria-label={`Image ${i + 1}`}
              >
                <img src={g.thumb} alt="" class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- ── Info column ── -->
      <div class="mt-10 lg:mt-0 flex flex-col">

        <!-- Title -->
        <h1 class="font-serif text-[clamp(36px,4vw,60px)] leading-[.97] tracking-tight font-normal">
          {product.name}
        </h1>

        <!-- Price -->
        <p class="mt-4 font-sans text-xl font-normal">
          €{product.price.toLocaleString("de-DE", { minimumFractionDigits: 2 })}
        </p>

        <!-- Stock/shipping status pill
             NOTE: static placeholder — connect to a real stock/shippingDays field in Sanity when available -->
        {isAvailable && (
          <div class="mt-4">
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ink/[.06] font-mono text-[11px] tracking-[.06em]">
              <span class="w-1.5 h-1.5 rounded-full bg-olive shrink-0" aria-hidden="true"></span>
              In stock · Shipping in 3–6 business days
            </span>
          </div>
        )}

        <!-- Short description -->
        {product.shortDescription && (
          <p class="mt-5 text-[15px] leading-relaxed opacity-75">
            {product.shortDescription}
          </p>
        )}

        <!-- Dimensions -->
        {product.dimensions && (product.dimensions.h || product.dimensions.w) && (
          <dl class="mt-5 flex gap-8">
            {product.dimensions.h !== undefined && (
              <div>
                <dt class="font-mono text-[10px] tracking-[.12em] uppercase opacity-55">Height</dt>
                <dd class="font-mono text-sm tabular-nums mt-0.5">{product.dimensions.h} cm</dd>
              </div>
            )}
            {product.dimensions.w !== undefined && (
              <div>
                <dt class="font-mono text-[10px] tracking-[.12em] uppercase opacity-55">Width</dt>
                <dd class="font-mono text-sm tabular-nums mt-0.5">{product.dimensions.w} cm</dd>
              </div>
            )}
          </dl>
        )}

        <!-- Desktop CTA — hidden on mobile (sticky bar handles it) -->
        <div class="mt-7">
          {isAvailable ? (
            <AddToCartButton
              client:visible
              productId={product.id}
              productName={product.name}
              price={product.price}
              shape={product.shape}
              color={product.color}
              category={product.category || "Piece"}
              edition={product.edition}
              imageUrl={product.imageUrl}
            />
          ) : (
            <button
              class="px-6 py-3 rounded-full bg-ink/10 text-ink/40 text-xs tracking-[.06em] uppercase font-semibold cursor-not-allowed"
              disabled
            >
              {product.status === "sold" ? "Sold out" : "Reserved"}
            </button>
          )}
        </div>

        <!-- Accordion sections -->
        <div class="mt-8 border-t border-ink">

          {product.description && (
            <details class="group border-b border-ink">
              <summary class="flex items-center justify-between py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <span class="font-sans text-[11px] tracking-[.12em] uppercase">About this piece</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                  <path d="M8 2v12M2 8h12"/>
                </svg>
              </summary>
              <p class="pb-5 text-[14px] leading-relaxed opacity-80 whitespace-pre-line">{product.description}</p>
            </details>
          )}

          <details class="group border-b border-ink">
            <summary class="flex items-center justify-between py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <span class="font-sans text-[11px] tracking-[.12em] uppercase">Care</span>
              <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M8 2v12M2 8h12"/>
              </svg>
            </summary>
            <p class="pb-5 text-[14px] leading-relaxed opacity-80 whitespace-pre-line">
              {product.care || "Hand-wash with mild soap and warm water. Avoid prolonged soaking. Dishwasher and microwave safe unless noted otherwise — but hand-washing keeps the glaze brightest."}
            </p>
          </details>

          <details class="group border-b border-ink">
            <summary class="flex items-center justify-between py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <span class="font-sans text-[11px] tracking-[.12em] uppercase">Shipping</span>
              <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M8 2v12M2 8h12"/>
              </svg>
            </summary>
            <div class="pb-5 text-[14px] leading-relaxed opacity-80">
              <p>Shipped from the Berlin studio within 3–5 business days. Each piece is wrapped by hand.</p>
              <p class="mt-2"><strong class="font-medium">Free shipping on orders over €120</strong> within the EU. International orders calculated at checkout.</p>
            </div>
          </details>

        </div>
      </div>
    </div>

    <!-- Related products -->
    {related.length > 0 && (
      <section class="mt-24 border-t border-ink/20 pt-16">
        <div class="grid grid-cols-12 gap-5">
          <div class="col-span-12 flex items-baseline justify-between mb-9">
            <span class="font-mono text-xs tracking-[.1em] uppercase opacity-65">More from the shelf</span>
            <a href="/shop" class="font-mono text-xs tracking-[.1em] uppercase opacity-65 hover:opacity-100 hover:underline underline-offset-[3px]">View all →</a>
          </div>
          {related.map((p, i) => (
            <div class="col-span-12 sm:col-span-6 lg:col-span-4">
              <ProductCard product={p} index={i} />
            </div>
          ))}
        </div>
      </section>
    )}
  </main>

  <!-- Mobile sticky CTA bar -->
  {isAvailable && (
    <div class="fixed bottom-0 left-0 right-0 z-40 bg-bone border-t border-ink px-4 py-3 flex items-center justify-between md:hidden">
      <div class="min-w-0 mr-4">
        <p class="font-sans text-sm font-medium leading-tight truncate">{product.name}</p>
        <p class="font-mono text-sm leading-tight mt-0.5">
          €{product.price.toLocaleString("de-DE", { minimumFractionDigits: 2 })}
        </p>
      </div>
      <AddToCartButton
        client:visible
        productId={product.id}
        productName={product.name}
        price={product.price}
        shape={product.shape}
        color={product.color}
        category={product.category || "Piece"}
        edition={product.edition}
        imageUrl={product.imageUrl}
      />
    </div>
  )}

  <!-- Lightbox -->
  <div
    id="gallery-lightbox"
    class="hidden fixed inset-0 z-50 bg-ink/90"
    role="dialog"
    aria-modal="true"
    aria-label="Fullscreen image"
  >
    <button
      id="gallery-lightbox-close"
      class="absolute top-4 right-4 w-10 h-10 rounded-full bg-paper/10 flex items-center justify-center text-paper/80 hover:text-paper transition-colors"
      aria-label="Close fullscreen"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M1 1l16 16M17 1 1 17"/>
      </svg>
    </button>
    <div class="flex items-center justify-center w-full h-full p-8">
      <img id="gallery-lightbox-img" src="" alt={product.name} class="max-h-full max-w-full object-contain" />
    </div>
  </div>
</Base>

<script>
  const mainImg = document.getElementById("gallery-main") as HTMLImageElement | null;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]");
  const dotBtns = document.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]");
  const lightbox = document.getElementById("gallery-lightbox");
  const lightboxImg = document.getElementById("gallery-lightbox-img") as HTMLImageElement | null;
  const lightboxClose = document.getElementById("gallery-lightbox-close");
  const zoomBtn = document.getElementById("gallery-zoom");

  function setActive(index: number) {
    const fullSrc = thumbBtns[index]?.dataset.full;
    if (fullSrc && mainImg) mainImg.src = fullSrc;

    thumbBtns.forEach((b, i) => {
      b.classList.toggle("border-ink", i === index);
      b.classList.toggle("border-ink/25", i !== index);
    });

    dotBtns.forEach((d, i) => {
      d.classList.toggle("bg-ink", i === index);
      d.classList.toggle("w-4", i === index);
      d.classList.toggle("bg-ink/30", i !== index);
      d.classList.toggle("w-1.5", i !== index);
    });
  }

  thumbBtns.forEach((btn, i) => btn.addEventListener("click", () => setActive(i)));
  dotBtns.forEach((btn, i) => btn.addEventListener("click", () => setActive(i)));

  zoomBtn?.addEventListener("click", () => {
    if (lightbox && lightboxImg && mainImg) {
      lightboxImg.src = mainImg.src;
      lightbox.classList.remove("hidden");
    }
  });

  function closeLightbox() {
    lightbox?.classList.add("hidden");
  }

  lightboxClose?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeLightbox(); });
</script>
