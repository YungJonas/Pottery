---
import ProductCard from "./ProductCard.astro";
import type { Product } from "../data/products";

interface Props {
  products: Product[];
  categories: string[];
}

const { products, categories } = Astro.props;
const filters = ["All", ...categories];

const requested = Astro.url.searchParams.get("category");
const selected = requested && filters.includes(requested) ? requested : "All";
---

<section class="pb-24">
  <!-- Header -->
  <div class="grid grid-cols-12 gap-x-5 items-end px-7 pt-16 pb-9">
    <div class="col-span-12 lg:col-span-7">
      <h2 class="font-serif text-[clamp(40px,6vw,88px)] leading-[.95] font-normal tracking-tight">
        All pieces, currently<br/>on the shelf.
      </h2>
    </div>

    <!-- Filter pills -->
    <div class="col-span-12 lg:col-span-5 flex flex-wrap gap-2 lg:justify-end" x-data={`{ filter: '${selected}' }`}>
      {filters.map((f) => (
        <button
          data-filter={f}
          x-on:click={`filter = '${f}'; document.querySelectorAll('[data-category]').forEach(el => { el.style.display = ('${f}' === 'All' || el.dataset.category === '${f}') ? '' : 'none'; }); { const u = new URL(window.location.href); if ('${f}' === 'All') u.searchParams.delete('category'); else u.searchParams.set('category', '${f}'); history.replaceState(null, '', u); }`}
          x-bind:class={`filter === '${f}' ? 'bg-ink text-paper border-ink' : 'border-ink'`}
          class:list={[
            "px-4 py-2.5 text-xs tracking-[.08em] uppercase font-semibold border rounded-full hover:-translate-y-px transition-all",
            f === selected ? "bg-ink text-paper border-ink" : "border-ink",
          ]}
        >
          {f}
        </button>
      ))}
    </div>
  </div>

  <!-- Product grid -->
  <div class="grid grid-cols-12 gap-5 px-7">
    {products.map((p, i) => {
      const visible = selected === "All" || p.category === selected;
      return (
        <div class="col-span-12 sm:col-span-6 lg:col-span-3" data-category={p.category || ""} style={visible ? undefined : "display:none"}>
          <ProductCard product={p} index={i} />
        </div>
      );
    })}
  </div>
</section>
