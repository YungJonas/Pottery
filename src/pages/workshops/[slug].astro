---
import Base from "../../layouts/Base.astro";
import AddToCartButton from "../../components/AddToCartButton";
import { sanity, urlFor } from "../../lib/sanity";

const { slug } = Astro.params;

const workshop = await sanity.fetch(
  `*[_type == "workshop" && slug.current == $slug][0]{
    _id, title, description, date, time, location, price, maxParticipants, image,
    "imageUrl": image.asset->url
  }`,
  { slug }
);

if (!workshop) {
  return Astro.redirect("/");
}

const dateObj = new Date(workshop.date + "T00:00:00");
const formattedDate = dateObj.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const ogImage = workshop.image
  ? urlFor(workshop.image).width(1200).height(630).url()
  : undefined;
---

<Base
  title={workshop.title}
  description={workshop.description || `${workshop.title} — pottery workshop.`}
  image={ogImage}
>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <a href="/" class="text-sm text-stone-500 hover:text-stone-700">&larr; Back to overview</a>

    <div class="mt-8 grid grid-cols-1 gap-10 md:grid-cols-2">
      <!-- Image -->
      <div>
        {workshop.image && (
          <img
            src={urlFor(workshop.image).width(600).height(600).url()}
            alt={workshop.title}
            class="w-full rounded-lg object-cover"
          />
        )}
      </div>

      <!-- Details -->
      <div>
        <span class="font-mono text-[10px] tracking-[.12em] uppercase opacity-65">Workshop</span>
        <h1 class="mt-1 text-3xl font-bold text-stone-800">{workshop.title}</h1>
        <p class="mt-2 text-xl text-stone-600">&euro;{workshop.price.toFixed(2)}</p>

        <dl class="mt-6 space-y-3 text-sm text-stone-600">
          <div class="flex gap-3">
            <dt class="font-semibold w-24 shrink-0">Date</dt>
            <dd>{formattedDate}</dd>
          </div>
          <div class="flex gap-3">
            <dt class="font-semibold w-24 shrink-0">Time</dt>
            <dd>{workshop.time}</dd>
          </div>
          <div class="flex gap-3">
            <dt class="font-semibold w-24 shrink-0">Location</dt>
            <dd>{workshop.location}</dd>
          </div>
          <div class="flex gap-3">
            <dt class="font-semibold w-24 shrink-0">Seats</dt>
            <dd>Max. {workshop.maxParticipants} participants</dd>
          </div>
        </dl>

        {workshop.description && (
          <p class="mt-6 text-stone-600 leading-relaxed">{workshop.description}</p>
        )}

        <div class="mt-8">
          <AddToCartButton
            client:visible
            productId={workshop._id}
            productName={workshop.title}
            price={workshop.price}
            shape="Bowl"
            color="terra"
            category="Workshop"
            edition="seat"
            imageUrl={workshop.imageUrl}
          />
        </div>
      </div>
    </div>
  </main>
</Base>
