---
import Vase from "./Vase.astro";
import AddToCartButton from "./AddToCartButton";
import type { Product } from "../data/products";
import { COLOR_MAP, frameBg } from "../data/products";

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;
const fill = COLOR_MAP[product.color];
const bg = frameBg(product.color);
const dims = `H ${30 + ((index * 3) % 18)} · W ${12 + (index % 6)}cm`;
---

<article class="flex flex-col">
  <!-- Frame (linked to detail page) -->
  <a href={`/shop/${product.slug}`} class="block group">
    <div class="relative aspect-[4/5] p-[18px] flex flex-col border border-ink" style={`background:${bg}`}>
      <div class="flex justify-between font-mono text-[10px] tracking-[.12em] uppercase opacity-70">
        <span>{String(index + 1).padStart(2, "0")}</span>
        <span>{product.edition.toUpperCase()}</span>
      </div>
      <div class="flex-1 flex items-center justify-center min-h-0 transition-transform duration-[350ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:-translate-y-1.5 group-hover:-rotate-[1.5deg]">
        {product.imageUrl ? (
          <img src={product.imageUrl} alt={product.name} class="h-[78%] w-auto max-h-60 object-contain" />
        ) : (
          <Vase shape={product.shape} fill={fill} class="h-[78%] w-auto max-h-60" />
        )}
      </div>
      <div class="flex justify-between font-mono text-[10px] tracking-[.12em] uppercase opacity-70 text-ink">
        <span>{dims}</span>
        <span>{product.year}</span>
      </div>
    </div>
  </a>

  <!-- Body (outside the link) -->
  <div class="pt-3.5 flex flex-col gap-2.5">
    <div class="flex justify-between items-baseline gap-3">
      <a href={`/shop/${product.slug}`} class="font-serif text-[22px] font-normal tracking-tight hover:underline underline-offset-2">{product.name}</a>
      <span class="font-mono text-sm font-medium tabular-nums">€{product.price}</span>
    </div>
    <p class="text-[13px] leading-relaxed opacity-70 min-h-[3.4em]">{product.description}</p>
    <div class="flex justify-between items-center gap-2 pt-1.5">
      <span class="px-2.5 py-1.5 border border-ink rounded-full text-[10px] tracking-[.1em] uppercase opacity-85">
        {product.category}
      </span>
      <AddToCartButton
        client:visible
        productId={product.id}
        productName={product.name}
        price={product.price}
        shape={product.shape}
        color={product.color}
        category={product.category}
        edition={product.edition}
        imageUrl={product.imageUrl}
      />
    </div>
  </div>
</article>
