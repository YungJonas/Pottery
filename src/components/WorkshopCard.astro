---
import type { Workshop } from "../data/workshops";

interface Props {
  workshop: Pick<
    Workshop,
    "title" | "slug" | "date" | "time" | "location" | "price" | "imageUrl"
  >;
  index: number;
  total: number;
}

const WORKSHOP_COLORS = ["#B5532A", "#A8916C", "#22364A", "#5C6233"];

const { workshop, index } = Astro.props;
const bg = WORKSHOP_COLORS[index % 4];

const dateObj = new Date(workshop.date + "T00:00:00");
const formattedDate = dateObj.toLocaleDateString("de-DE", { day: "numeric", month: "long", year: "numeric" });
---

<a href={`/workshops/${workshop.slug}`} class="group block">
  <article
    class="aspect-[3/4] flex flex-col overflow-hidden relative border border-black rounded-[8px]"
    style={`background-color: ${bg};`}
  >
    <!-- Cover image — full bleed, no padding -->
    <div class="flex-1 overflow-hidden">
      {workshop.imageUrl ? (
        <img
          src={workshop.imageUrl}
          alt={workshop.title}
          class="w-full h-full object-cover"
        />
      ) : (
        <div class="w-full h-full bg-paper/10" />
      )}
    </div>

    <!-- Content -->
    <div class="p-5 sm:p-6">
      <!-- Title -->
      <h3 class="font-serif text-[clamp(28px,3vw,32px)] leading-[1.05] font-normal text-paper tracking-tight">
        {workshop.title}
      </h3>

      <!-- Metadata -->
      <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3">
        <div class="flex flex-col gap-y-3 font-sans text-paper">
          <div>
            <span class="block text-xs tracking-[.08em] opacity-60">Datum</span>
            <span class="text-base">{formattedDate}</span>
          </div>
          <div>
            <span class="block text-xs tracking-[.08em] opacity-60">Uhrzeit</span>
            <span class="text-base">{workshop.time}</span>
          </div>
        </div>
        <div class="flex flex-col gap-y-3 font-sans text-paper">
          <div>
            <span class="block text-xs tracking-[.08em] opacity-60">Ort</span>
            <span class="text-base">{workshop.location}</span>
          </div>
          <div>
            <span class="block text-xs tracking-[.08em] opacity-60">Preis</span>
            <span class="text-base">&euro;{workshop.price}</span>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-4">
        <span class="block w-full text-center font-sans text-sm font-normal rounded-full py-4 px-4 transition-transform hover:-translate-y-px" style="background: rgb(28, 27, 23); color: rgb(246, 241, 230);">
          Jetzt anmelden
        </span>
      </div>
    </div>
  </article>
</a>
