---
import Vase from "./Vase.astro";
import type { Product } from "../data/products";
import { COLOR_MAP, frameBg } from "../data/products";

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;
const fill = COLOR_MAP[product.color];
const bg = frameBg(product.color);
---

<article>
  <a href={`/shop/${product.slug}`} class="block group">
    <div class="relative aspect-square overflow-hidden" style={`background:${bg}`}>
      <div class="w-full h-full flex items-center justify-center transition-transform duration-[350ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:-translate-y-1.5 group-hover:-rotate-[1.5deg]">
        {product.imageUrl ? (
          <img src={product.imageUrl} alt={product.name} class="w-full h-full object-cover" />
        ) : (
          <Vase shape={product.shape} fill={fill} class="w-full h-full" />
        )}
      </div>

      <!-- Bag icon indicator -->
      <div class="absolute bottom-3 right-3 w-8 h-8 rounded-full bg-bone/80 backdrop-blur-sm border border-ink/10 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
      </div>
    </div>
  </a>

  <div class="pt-3.5 flex flex-col gap-2.5">
    <div class="flex justify-between items-baseline gap-3">
      <a href={`/shop/${product.slug}`} class="font-serif text-[22px] font-normal tracking-tight hover:underline underline-offset-2">{product.name}</a>
      <span class="font-mono text-sm font-medium tabular-nums">€{product.price}</span>
    </div>
    <p class="text-[13px] leading-relaxed opacity-70 min-h-[3.4em]">{product.description}</p>
  </div>
</article>
