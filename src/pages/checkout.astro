---
import Base from "../layouts/Base.astro";
---

<Base title="Checkout" description="Complete your purchase.">
  <main class="mx-auto max-w-2xl px-6 py-20 text-center">
    <h1 class="font-serif text-4xl font-light mb-4">Checkout</h1>
    <p class="opacity-65 mb-8">Checkout coming soon. We're setting up secure payments.</p>
    <a
      href="/shop"
      class="inline-block px-6 py-3 bg-ink text-paper rounded-full text-sm uppercase tracking-[.06em] font-semibold hover:-translate-y-px transition-transform"
    >
      Back to shop
    </a>
  </main>
</Base>
