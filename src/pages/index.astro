---
import Base from "../layouts/Base.astro";
import Shop from "../components/Shop.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import { sanity } from "../lib/sanity";
import { mapSanityProduct } from "../data/products";
import { mapSanityWorkshop, isUpcoming } from "../data/workshops";

const rawWorkshops = await sanity.fetch(
  `*[_type == "workshop"]{
    _id, title, description, date, startTime, endTime, time, location, price,
    maxParticipants, spotsRemaining, skillLevel, includes, bring, instructor,
    "slug": slug.current,
    "imageUrl": coalesce(images[0].asset->url, image.asset->url),
    "imageUrls": images[].asset->url
  } | order(date asc)`
);
const allWorkshops = rawWorkshops.map((w: any) => mapSanityWorkshop(w));
const upcoming = allWorkshops.filter((w) => isUpcoming(w.date));
const upcomingWorkshops = (upcoming.length > 0 ? upcoming : allWorkshops).slice(0, 4);

const rawProducts = await sanity.fetch(
  `*[_type == "product"]{
    _id, title, price, description, shortDescription, care, dimensions, status,
    "slug": slug.current,
    category,
    "imageUrl": images[0].asset->url,
    "imageUrls": images[].asset->url,
    available
  } | order(available desc, title asc)`
);
const products = rawProducts.map((p: any, i: number) => mapSanityProduct(p, i));
const categories = [...new Set(products.map((p) => p.category).filter(Boolean))] as string[];
---

<Base title="Home" description="Handmade pottery and workshops — shaped by hand, one piece at a time.">
  <!-- Hero -->
  <section class="grid grid-cols-12 gap-x-5 px-4 sm:px-7 pt-20 pb-10">
    <div class="col-span-12 lg:col-span-8">
      <h1 class="font-sans text-[clamp(48px,8vw,110px)] leading-[.92] font-[440] tracking-[-0.03em]">
        Socializen. Statt scrollen.
      </h1>
      <p class="mt-5 text-[15px] leading-relaxed opacity-70 max-w-md">
        Kleine Workshops in deiner Stadt. Etwas mit den Händen machen, neue Leute treffen, einen Abend lang offline sein.
      </p>
    </div>
  </section>

  <!-- Workshops -->
  {upcomingWorkshops.length > 0 && (
    <section class="pb-20" x-data="{}">
      <div class="flex items-end justify-between px-4 sm:px-7 pt-8 pb-9">
        <h2 class="font-serif text-[clamp(28px,4vw,56px)] leading-[1.1] font-[440] tracking-[-0.03em]">
          Anstehende Workshops:
        </h2>
        <div class="flex gap-2 pb-1">
          <button
            @click="$refs.slider.scrollBy({ left: -$refs.slider.offsetWidth, behavior: 'smooth' })"
            class="size-10 rounded-full border border-black flex items-center justify-center hover:bg-black hover:text-paper transition-colors"
            aria-label="Zurück"
          >&#8592;</button>
          <button
            @click="$refs.slider.scrollBy({ left: $refs.slider.offsetWidth, behavior: 'smooth' })"
            class="size-10 rounded-full border border-black flex items-center justify-center hover:bg-black hover:text-paper transition-colors"
            aria-label="Weiter"
          >&#8594;</button>
        </div>
      </div>
      <div
        x-ref="slider"
        class="flex gap-2 sm:gap-5 px-4 sm:px-7 overflow-x-auto scroll-smooth snap-x snap-mandatory [scroll-padding-left:1rem] sm:[scroll-padding-left:1.75rem] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {upcomingWorkshops.map((w, i) => (
          <div class="snap-start shrink-0 w-[calc(100vw-4rem)] sm:w-[calc(50vw-2.5rem)] lg:w-[calc(25vw-2rem)]">
            <WorkshopCard workshop={w} index={i} total={upcomingWorkshops.length} />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Pottery catalogue -->
  <Shop products={products} categories={categories} />
</Base>
