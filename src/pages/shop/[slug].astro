---
import Base from "../../layouts/Base.astro";
import AddToCartButton from "../../components/AddToCartButton";
import { sanity, urlFor } from "../../lib/sanity";
import { mapSanityProduct } from "../../data/products";

const { slug } = Astro.params;

const product = await sanity.fetch(
  `*[_type == "product" && slug.current == $slug][0]{
    _id, title, description, price, images, available,
    "category": category,
    "imageUrl": images[0].asset->url
  }`,
  { slug }
);

if (!product) {
  return Astro.redirect("/shop");
}

const mapped = mapSanityProduct(product, 0);
const ogImage = product.images?.[0]
  ? urlFor(product.images[0]).width(1200).height(630).url()
  : undefined;
---

<Base
  title={product.title}
  description={product.description || `${product.title} — handmade pottery.`}
  image={ogImage}
>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <a href="/shop" class="text-sm text-stone-500 hover:text-stone-700">&larr; Back to shop</a>

    <div class="mt-8 grid grid-cols-1 gap-10 md:grid-cols-2">
      <div class:list={[!product.available && "opacity-50 grayscale"]}>
        {product.images?.length > 0 && (
          <img
            src={urlFor(product.images[0]).width(600).height(600).url()}
            alt={product.title}
            class="w-full rounded-lg object-cover"
          />
        )}
        {product.images?.length > 1 && (
          <div class="mt-4 grid grid-cols-4 gap-2">
            {product.images.slice(1).map((img: any) => (
              <img
                src={urlFor(img).width(150).height(150).url()}
                alt={product.title}
                class="rounded object-cover aspect-square"
              />
            ))}
          </div>
        )}
      </div>

      <div>
        <h1 class="text-3xl font-bold text-stone-800">{product.title}</h1>
        <p class="mt-2 text-xl text-stone-600">${product.price.toFixed(2)}</p>

        {!product.available && (
          <p class="mt-3 text-sm font-medium text-red-600">Sold Out</p>
        )}

        {product.description && (
          <p class="mt-6 text-stone-600 leading-relaxed">{product.description}</p>
        )}

        {product.available ? (
          <div class="mt-8">
            <AddToCartButton
              client:visible
              productId={mapped.id}
              productName={mapped.name}
              price={mapped.price}
              shape={mapped.shape}
              color={mapped.color}
              category={mapped.category}
              edition={mapped.edition}
              imageUrl={mapped.imageUrl}
            />
          </div>
        ) : (
          <button
            class="mt-8 w-full rounded-full bg-ink/20 text-ink/50 px-6 py-3 text-sm uppercase tracking-[.06em] font-semibold cursor-not-allowed"
            disabled
          >
            Sold Out
          </button>
        )}
      </div>
    </div>
  </main>
</Base>
